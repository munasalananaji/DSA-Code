package StreamPrograms.non_string_programs;
import java.util.*;
import java.util.stream.Collectors;
public class SumOfTransactionAmounts {

	public static void main(String[] args) {
		List<Transaction> transactions = Arrays.asList(
			    new Transaction("2022-01-01", 100),
			    new Transaction("2022-01-01", 200),
			    new Transaction("2022-01-02", 300),
			    new Transaction("2022-01-02", 400),
			    new Transaction("2022-01-03", 500)
			);
		
	Map<String, Integer> Resultantlist =	transactions.stream().
			                          collect(Collectors.groupingBy(a -> a.getDate() , Collectors.summingInt(k -> k.getAmount())));
	
	System.out.println(Resultantlist);

		

	}

}

class Transaction {
    private String date;
    private int amount;

    public Transaction(String date, int amount) {
        this.date = date;
        this.amount = amount;
    }

    public String getDate() {
        return date;
    }

    public int getAmount() {
        return amount;
    }
}
